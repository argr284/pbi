Show_Date_Flag :=
VAR SelectedPeriod =
    SELECTEDVALUE ( 'PeriodSelector'[PeriodType] )

VAR AxisDate =
    MAX ( 'DateTable'[Date] )

VAR MaxDateInData =
    CALCULATE ( MAX ( 'DateTable'[Date] ), ALL ( 'DateTable' ) )

RETURN
SWITCH (
    TRUE (),

    SelectedPeriod = "YTD"
        && YEAR ( AxisDate ) = YEAR ( MaxDateInData )
        && AxisDate <= MaxDateInData, 1,

    SelectedPeriod = "Current Month"
        && YEAR ( AxisDate ) = YEAR ( MaxDateInData )
        && MONTH ( AxisDate ) = MONTH ( MaxDateInData ), 1,

    SelectedPeriod = "Previous Month"
        && AxisDate >= EOMONTH ( MaxDateInData, -2 ) + 1
        && AxisDate <= EOMONTH ( MaxDateInData, -1 ), 1,

    SelectedPeriod = "Custom Range", 1,

    0
)
